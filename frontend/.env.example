# Copy to frontend/.env.local for local overrides (gitignored).
#
# EVERY VITE_* variable is compiled into the public JavaScript bundle and
# readable by anyone who opens the site. Never put an API key, database
# URL or any other secret here — those belong in server/.env, and the
# browser reaches them only through the backend API.

# Base URL of the Libas API. Unset in local dev (falls back to "/api",
# proxied to localhost:4000 by vite.config.js). Production sets it in
# .github/workflows/deploy-frontend.yml — keep public/_headers'
# connect-src in sync with it.
# VITE_API_BASE=https://3-235-254-9.nip.io/api
