# Copy to server/.env (gitignored, and excluded from the Docker build
# context by .dockerignore) and fill in real values. This file is the ONLY
# place backend secrets live — nothing here is ever shipped to the browser.
# The frontend talks to OpenAI exclusively through this API.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Optional (defaults shown) -------------------------------------------
# SEARCH_MODEL=gpt-6-luna

# Postgres — db.py's defaults match db/docker-compose.yml for local dev.
# Inside Docker, docker-compose.yml sets PGHOST/PGPORT/PGPASSWORD itself.
# PGHOST=localhost
# PGPORT=5433
# PGDATABASE=libas
# PGUSER=libas
# PGPASSWORD=libas_dev_password

# Browser origins allowed to call the API (CORS), comma-separated. The
# default covers the live workers.dev site plus local Vite dev/preview —
# add a custom domain here when one exists.
# ALLOWED_ORIGINS=https://ai-clothing-aggregator.ibrahimumair900.workers.dev,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Rate limits for POST /api/search (rate_limit.py). Every search costs two
# OpenAI calls; the global cap is the hard daily spend ceiling.
# SEARCH_RATE_PER_MINUTE=10
# SEARCH_RATE_PER_DAY=300
# SEARCH_GLOBAL_DAILY_CAP=5000
