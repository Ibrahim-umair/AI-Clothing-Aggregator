# Copy to db/.env (already gitignored — see root .gitignore's *.env rule)
# and fill in real values. Local dev works with NO db/.env at all: every
# variable below falls back to these same dev defaults inside
# db/docker-compose.yml, so this file is only needed to override them
# (i.e. on the production host).

POSTGRES_PASSWORD=libas_dev_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
