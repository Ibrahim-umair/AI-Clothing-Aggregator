# Local config / secrets — never commit
.env
*.env
.env.*

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc

# Logs
*.log

# Raw scrape output (hundreds of MB, regenerable via db/scraper/run_scrape.py
